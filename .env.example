LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

KNOWLEDGE_DIR=knowledge
RAG_TOP_K=4
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*
